# Recommended: import-session.mjs generates .env and session.local.json.
PROXY_KEY=replace-with-a-random-key-of-at-least-24-characters
QUICK_SESSION_FILE=./session.local.json
PORT=8787
QUICK_TIMEOUT_MS=120000
# Optional overrides when not using the imported session:
# QUICK_ACCOUNT_ID=123456789012
# QUICK_COOKIE=your-current-full-Cookie-header
# QUICK_CSRF=your-current-percent-encoded-X-Amzn-Csrf-Token
# QUICK_OUTBOUND_PROXY=http://127.0.0.1:7897
