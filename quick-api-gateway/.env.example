# Linux host network: Quick services must already listen on 127.0.0.1:8787/8788.
QUICK_CLIENT_HOST_FILE=/opt/quick-api/quick-proxy/client.local.json
GATEWAY_STATE_HOST_DIR=/opt/quick-api/state
# Replace with: id -u quick-api / id -g quick-api
QUICK_SERVICE_UID=1000
QUICK_SERVICE_GID=1000
# Separate test ports keep the existing systemd gateway and public entry running.
GATEWAY_PORT=18789
QUICK_BIND_ADDR=127.0.0.1
QUICK_HTTP_PORT=18080
QUICK_HTTPS_PORT=18443
QUICK_TLS_DOMAIN=moyubooks.icu
# Directory must contain fullchain.pem and privkey.pem; certificates are not bundled.
TLS_CERT_DIR=./tls
GATEWAY_IMAGE=quick-api-gateway:keypool
NGINX_IMAGE=nginx:stable-alpine
UPSTREAM_MAX_ATTEMPTS=4
RETRY_STATUS_CODES=401,403,429
REQUEST_TIMEOUT_MS=180000
# Leave both empty to retain the existing internal key. Choose one if configuring a pool.
# This path is INSIDE the container, in the mounted state directory.
GATEWAY_UPSTREAM_KEYS_FILE=
UPSTREAM_API_KEYS=
